# Database (PostgreSQL) — bisa pakai Supabase, Neon, atau Vercel Postgres
DATABASE_URL="postgresql://user:password@host:5432/jepara_digital_furniture"

# NextAuth
# Generate secret dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-secret-acak-yang-panjang"
NEXTAUTH_URL="http://localhost:3000"

# Dipakai HANYA saat menjalankan `npm run db:seed` untuk membuat akun admin pertama.
# Setelah seed berhasil, boleh dihapus dari .env (password sudah ter-hash di database).
ADMIN_EMAIL="admin@jeparadigitalfurniture.id"
ADMIN_PASSWORD="ganti-password-ini"

# Vercel Blob — untuk fitur upload gambar dari panel admin.
# Buat via dashboard Vercel: Storage tab → Create Database → Blob → Connect ke project ini,
# token akan otomatis muncul di Environment Variables Vercel.
# Untuk pengembangan lokal, salin token yang sama ke sini (lihat README).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
